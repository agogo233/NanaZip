#include "PasswordManagerDialogRes.h"
#include "../../GuiCommon.rc"

// **************** NanaZip Modification Start ****************
#define xc 420
#define yc 160

#define bx4 (bx3 - m - bxs)
#define bx5 (bx4 - m - bxs)

IDD_PASSWORD_MANAGER  DIALOG  0, 0, xs, ys  MY_MODAL_RESIZE_DIALOG_STYLE  MY_FONT
CAPTION "NanaZip: Saved passwords"
BEGIN
  CONTROL "List1", IDL_PM_LIST, "SysListView32",
          LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
          m, m, xc, yc - bys - m
  CONTROL  "Show &passwords", IDX_PM_SHOWPLAIN, MY_CHECKBOX, m, by, bx5 - m - m, 10
  PUSHBUTTON "&Remove", IDB_PM_REMOVE, bx5, by, bxs, bys
  PUSHBUTTON "&Clear all", IDB_PM_CLEARALL, bx4, by, bxs, bys
  PUSHBUTTON "&Master...", IDB_PM_CHANGEMASTER, bx3, by, bxs, bys
  PUSHBUTTON "&Lock", IDB_PM_LOCK, bx2, by, bxs, bys
  DEFPUSHBUTTON  "C&lose", IDOK, bx1, by, bxs, bys
END
// **************** NanaZip Modification End ****************
