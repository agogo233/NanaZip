#include "PasswordMasterDialogRes.h"
#include "../../GuiCommon.rc"

// **************** NanaZip Modification Start ****************
#ifdef UNDER_CE
#define xc 140
#else
#define xc 200
#endif
#define yc 112

IDD_PASSWORD_MASTER  DIALOG  0, 0, xs, ys  MY_MODAL_DIALOG_STYLE  MY_FONT
CAPTION "Set master password"
BEGIN
  LTEXT    "", IDT_PM_INFO, m, m, xc, 24
  LTEXT    "&Password:", IDT_PM_PASSWORD_ENTER, m, 34, xc, 8
  EDITTEXT  IDE_PM_PASSWORD, m, 44, xc, 14, ES_PASSWORD | ES_AUTOHSCROLL
  LTEXT    "&Confirm password:", IDT_PM_PASSWORD2, m, 62, xc, 8
  EDITTEXT  IDE_PM_PASSWORD2, m, 72, xc, 14, ES_PASSWORD | ES_AUTOHSCROLL
  CONTROL  "&Show password", IDX_PM_SHOW, MY_CHECKBOX, m, 92, xc, 10
  OK_CANCEL
END
// **************** NanaZip Modification End ****************
